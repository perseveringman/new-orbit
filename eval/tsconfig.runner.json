{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["runner/**/*.ts", "../src/main/**/*.ts", "../src/shared/**/*.ts"]
}
