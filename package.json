{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit — personal-vision AI collaboration workbench. An Obsidian-compatible Markdown + local Git workbench that orchestrates Claude Code CLI sub-agents in parallel worktrees.",
  "author": {
    "name": "Orbit Contributors"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:cli",
    "start": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --mac --dir --config electron-builder.yml",
    "e2e:install": "playwright install chromium",
    "e2e": "npm run build && playwright test",
    "test:all": "npm run test && npm run e2e",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=out/cli/index.js --alias:@shared=./src/shared",
    "cli": "npm run build:cli -- --log-level=warning && node out/cli/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "fix-path": "^5.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.9.0",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.9",
    "node-pty": "^1.1.0",
    "simple-git": "^3.25.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "homepage": "https://github.com/your-org/orbit",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/orbit.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "bin": {
    "orbit": "bin/orbit"
  }
}
